{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planning-poker-astro",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"],
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/game/*", "/ws/*", "/api/game/*"],
  },
  "observability": {
    "enabled": true,
  },
}
